# Copy this file to .env and paste your keys after the = (no quotes, no spaces). .env is git-ignored.
# NEVER put real keys in this file – .env.example is committed to git.
OJ_API_KEY=
# Only change if requests return 404:
OJ_BASE_URL=https://api.openjustice.ai
# Optional, only for `ojbench playground` (direct Apertus via https://platform.publicai.co):
PUBLICAI_API_KEY=
PUBLICAI_MODEL=
# App (streamlit run app/streamlit_app.py):
# ID of the protocol built in the OpenJustice editor (preselected in the app; empty = first own protocol)
OJ_PROTOCOL_ID=
# Model id, e.g. the Apertus id from `python3 -m ojbench models` (empty = first Apertus model offered)
OJ_MODEL=
APP_NAME=ProtoLex
# 1 = offline demo with fake answers (automatic when OJ_API_KEY is empty)
APP_MOCK=
# Topic shown above the input (empty = description of the protocol in OpenJustice), e.g. "Mängel an der Mietsache"
APP_SCOPE=
